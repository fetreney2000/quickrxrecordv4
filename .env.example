# QuickRxRecord v4 — salin ke .env dan isi nilai sebenar.
# JANGAN commit .env (ia telah diabaikan dalam .gitignore).

# ── Supabase (klien awam — selamat dibina ke bundle) ──
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-dari-dashboard>

# ── Supabase (pelayan SAHAJA — jangan tambah prefix VITE_) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-dari-dashboard>

# ── Auth ──
# Rawak 32+ bait (jana: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
SESSION_SECRET=<rawak-32-bait-minimum>
# MESTI sepadan dengan Supabase Dashboard → Settings → API → JWT Secret.
# Tanpa ini /api/login dan /api/session gagal (500) dan RLS 039 menyekat semua query.
SUPABASE_JWT_SECRET=<jwt-secret-dari-supabase-dashboard>

# ── Pilihan: origin tambahan untuk CORS API (koma-terpisah) ──
# Contoh: ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# localhost sentiasa dibenarkan untuk dev; VERCEL_URL dibenarkan automatik.
# ALLOWED_ORIGINS=
